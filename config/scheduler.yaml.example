# checkGPRobot 调度策略模板（实际配置复制为 scheduler.yaml）
broadcast:
  times:
    - "09:00"
    - "18:00"
  weekdays_only: true   # 周六周日不播
  skip_if_no_change: true  # 状态无变化时跳过（避免刷屏）
  per_status_thresholds:
    MAKING: 14          # 超过 14 天 → ⚠
    CLIENT_REVIEW: 7
    UNPAID: 30
  # 内部管理群（区别于 admin_chat_id 私聊告警）：
  # 这些群会收所有项目的播报。客户群（项目群映射 sheet 里配置的）只收自己的项目。
  # 留空 = 不发到任何内部群。
  admin_broadcast_chats:
    - "-1004465951132"   # 替换为你的内部管理群 chat_id

  # 事件驱动模式：每 N 分钟 refresh sheet，状态变化立即播报该项目
  # 设为 0 则改用上面 times[] 的 cron 定时全员播报（旧模式）
  # 默认 5 分钟；推荐 2-5 分钟；过低会增加 Google API 调用频率
  refresh_interval_minutes: 5
